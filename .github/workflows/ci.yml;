name: Mirai Hub CI Pipeline 🚀

on:
  push:
    branches: [ main, develop ]
  pull_request:
    branches: [ main ]

jobs:
  validate-and-build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Repository Source
      uses: actions/checkout@v4

    - name: Setup Node.js Environment
      uses: actions/setup-node@v4
      with:
        node-version: '20'
        cache: 'npm'

    - name: Install Monorepo Dependencies
      run: npm ci

    - name: Validate Prisma Database Structural Integrity
      run: |
        cd packages/database
        npx prisma validate

    - name: Generate Type-Safe Database Clients
      run: |
        cd packages/database
        npx prisma generate

    - name: Compile and Test Frontend Web App (TypeScript Check)
      run: |
        cd apps/web
        npm run build

    - name: Compile Desktop App Window Layer
      run: |
        cd apps/desktop
        npm run build

    - name: Pipeline Status Affirmation
      run: echo "🚀 Mirai Hub continuous integration validation checks passed successfully!"
