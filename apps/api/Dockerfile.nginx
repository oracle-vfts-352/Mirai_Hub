# Stage 1: build the web app
FROM node:22-alpine AS build
WORKDIR /app

# Whole repo (.dockerignore keeps out node_modules, .env files, .git and build output)
COPY . .

# Only the web workspace (skips the API and Electron)
RUN npm ci --workspace=web --include-workspace-root
RUN npm run build --workspace=web

# Stage 2: nginx serves the built files and proxies /api to the API
FROM nginx:alpine
COPY apps/api/config/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html