{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,         // 👈 CRUCIAL: Forces older packages to match ES module shapes
    "allowSyntheticDefaultImports": true, // 👈 Allows clean, intuitive default imports
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "rootDir": "./src" 
  },
  "include": ["src/**/*"]
}
