# Copy the parts you need into the real files. The real files are git-ignored: never commit them.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"

# ---- root .env (read by docker compose) ----
JWT_SECRET=
POSTGRES_PASSWORD=
# must match docker/seaweedfs-s3.json (copy docker/seaweedfs-s3.example.json first)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- apps/api/.env (read by the API and worker when run with npm) ----
# PORT=5000
# JWT_SECRET=
# REDIS_URL=redis://localhost:6380
# RP_ID=localhost
# ORIGIN=http://localhost:5173
# ENABLE_DEV_LOGIN=true
# DATABASE_URL=postgresql://mirai_admin:<POSTGRES_PASSWORD>@localhost:5433/mirai_hub?schema=public
# TEST_DATABASE_URL=postgresql://mirai_admin:<POSTGRES_PASSWORD>@localhost:5433/mirai_hub_test?schema=public
# S3_ENDPOINT=http://localhost:8333
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=mirai-media
# MEDIA_PUBLIC_URL=http://localhost:8333/mirai-media

# SMTP_HOST
# SMTP_PORT
# SMTP_FROM
# SMTP_USER
# SMTP_PASS
# SMTP_SECURE

# ---- packages/database/.env (read by Prisma commands) ----
# DATABASE_URL="postgresql://mirai_admin:<POSTGRES_PASSWORD>@localhost:5433/mirai_hub?schema=public"


