datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CONSUMER
  DEV
}

enum PostType {
  VISION
  ANNOUNCEMENT
  CHANGELOG
}

enum FeedbackStatus {
  OPEN
  UNDER_REVIEW
  PLANNED
  IN_PROGRESS
  SHIPPED
  DECLINED
}

enum NotificationType {
  FEEDBACK_STATUS
  NEW_POST
}

model User {
  id            String          @id @default(uuid(7)) @db.Uuid
  email         String          @unique
  name          String
  role          Role            @default(CONSUMER)
  passkeys      DevicePasskey[]
  projects      Project[]
  follows       Follow[]
  feedback      Feedback[]
  votes         Vote[]
  notifications Notification[]
  createdAt     DateTime        @default(now())
}

model DevicePasskey {
  id           String   @id @default(uuid(7)) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      Int
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Project {
  id            String         @id @default(uuid(7)) @db.Uuid
  slug          String         @unique
  name          String
  tagline       String?
  vision        String?
  ownerId       String         @db.Uuid
  owner         User           @relation(fields: [ownerId], references: [id])
  posts         Post[]
  feedback      Feedback[]
  followers     Follow[]
  notifications Notification[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerId])
}

model Post {
  id        String   @id @default(uuid(7)) @db.Uuid
  projectId String   @db.Uuid
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      PostType
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model Feedback {
  id        String         @id @default(uuid(7)) @db.Uuid
  projectId String         @db.Uuid
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String         @db.Uuid
  author    User           @relation(fields: [authorId], references: [id])
  title     String
  body      String
  status    FeedbackStatus @default(OPEN)
  votes     Vote[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([projectId, status])
}

model Vote {
  userId     String   @db.Uuid
  feedbackId String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feedback   Feedback @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, feedbackId])
}

model Follow {
  userId    String   @db.Uuid
  projectId String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, projectId])
}

model Notification {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String           @db.Uuid
  project   Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type      NotificationType
  refId     String           @db.Uuid // feedback id or post id, depending on type
  dedupeKey String // one event per user, makes retries and re-runs harmless
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}